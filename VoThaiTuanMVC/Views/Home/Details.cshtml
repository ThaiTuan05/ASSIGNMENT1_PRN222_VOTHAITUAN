@model BusinessObjects.Entities.NewsArticle
@{
    ViewData["Title"] = Model.NewsTitle;
    var related = ViewBag.Related as List<BusinessObjects.Entities.NewsArticle> ?? new();
}
@functions {
    string G(short? id) => "g" + ((id ?? 0) % 6);
    string Initial(string? name)
    {
        var s = (name ?? "F").Trim();
        return s.Length == 0 ? "F" : s.Substring(0, 1).ToUpper();
    }
}

<div class="row g-4">
    <div class="col-lg-8">
        <article class="article">
            <div class="article-cover @G(Model.CategoryId)">
                <span class="cover-mark">@Initial(Model.Category?.CategoryName)</span>
            </div>
            <div class="article-inner">
                <span class="kicker">@Model.Category?.CategoryName</span>
                <h1>@Model.NewsTitle</h1>
                <div class="article-meta">
                    <span>By <strong>@Model.CreatedBy?.AccountName</strong></span>
                    <span class="dot"></span>
                    <span>@Model.CreatedDate?.ToString("dd MMMM yyyy, HH:mm")</span>
                    @if (Model.NewsStatus != true)
                    {
                        <span class="dot"></span>
                        <span class="badge-inactive" style="padding:3px 9px;border-radius:999px;">Inactive</span>
                    }
                </div>

                <p class="article-lead">@Model.Headline</p>

                <div class="article-body" style="white-space: pre-line;">@Model.NewsContent</div>

                <div class="article-tags">
                    <strong>Tags:</strong>
                    @if (Model.Tags.Any())
                    {
                        @foreach (var tag in Model.Tags)
                        {
                            <span class="chip">#@tag.TagName</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">None</span>
                    }
                </div>
                <div class="mt-3 text-muted small">
                    Source: @(string.IsNullOrWhiteSpace(Model.NewsSource) ? "N/A" : Model.NewsSource)
                </div>
            </div>
        </article>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-ghost btn-sm">&larr; Back to all news</a>
        </div>
    </div>

    <aside class="col-lg-4">
        @if (related.Any())
        {
            <div class="widget">
                <h4>Related Stories</h4>
                @foreach (var item in related)
                {
                    <div class="related-item">
                        <span class="ri-thumb @G(item.CategoryId)">@Initial(item.Category?.CategoryName)</span>
                        <div>
                            <h5><a asp-action="Details" asp-route-id="@item.NewsArticleId">@item.NewsTitle</a></h5>
                            <time>@item.CreatedDate?.ToString("dd MMM yyyy")</time>
                        </div>
                    </div>
                }
            </div>
        }
        <div class="widget">
            <h4>About this story</h4>
            <p class="small text-muted mb-0">
                Category: <strong>@Model.Category?.CategoryName</strong><br />
                Published: @Model.CreatedDate?.ToString("dd MMM yyyy")<br />
                Last updated: @(Model.ModifiedDate?.ToString("dd MMM yyyy") ?? "N/A")
            </p>
        </div>
    </aside>
</div>
